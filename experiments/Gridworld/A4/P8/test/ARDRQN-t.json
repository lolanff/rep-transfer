{
    "agent": "ARDRQN-ReLU-t",
    "problem": "DirectionalTMaze",
    "total_steps": 100000,
    "episode_cutoff": 100,
    "metaParameters": {
        "experiment": {
            "load": false,
            "save": false,
            "seed_offset": 30000
        },
        "epsilon": 0.1,
        "target_refresh": 64,
        "buffer_type": "rnn_uniform",
        "buffer_size": 10000,
        "batch": 1,
        "n_step": 1,
        "update_freq": 1,
        "sequence_length": 32,
        "train_use_all_steps": true,

        "optimizer": {
            "name": "ADAM",
            "alpha": 0.0001,
            "beta1": 0.9,
            "beta2": 0.999
        },
        "representation": {
            "type": "MazeARGRUNet",
            "hidden": 32,
            "actions": 3,
            "frozen": false
        },
        "environment": {
            "corridor_length": 5
        }
    }
}
