{
    "agent": "DRQN-3",
    "problem": "ForagerTwoBiomeLarge",
    "total_steps": 500000,
    "episode_cutoff": -1,
    "metaParameters": {
        "loss": "huber",
        "epsilon_init": 1,
        "epsilon_final": 0.05,
        "epsilon_steps": 400000,
        "target_refresh": 128,
        "buffer_type": "rnn_uniform",
        "buffer_size": 10000,
        "batch": 2,
        "gamma": 0.99,
        "n_step": 1,
        "update_freq": 1,
        "sequence_length": 128,
        "environment": {
            "aperture": 3
        },
        "experiment": {
            "seed_offset": 0
        },
        "optimizer": {
            "name": "ADAM",
            "alpha": [0.001, 0.0003, 0.0001, 0.00003, 0.00001],
            "beta1": 0.9,
            "beta2": 0.9,
            "eps": 1e-08
        },
        "representation": {
            "type": "ForagerGRUNetReLU",
            "hidden": 64
        }
    }
}